# Data: too large / not owned by you; regenerable from source
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
*.egg-info/
.pytest_cache/

# Local Claude Code settings (personal, not shared)
.claude/settings.local.json

# Model checkpoints / heavy outputs
*.pt
*.pth
*.h5

# OS
.DS_Store
Thumbs.db
